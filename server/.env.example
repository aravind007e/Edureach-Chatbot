# EduReach Server Environment Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/edureach

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Ollama LLM & Embedding Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# RAG Retrieval Settings
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.40

# AI Voice Counselor (Vapi)
# Note: Outbound telephony dispatch requires a VAPI_PRIVATE_KEY on the server.
# The public key belongs on the frontend (VITE_VAPI_PUBLIC_KEY) for instant in-browser WebRTC voice calls.
VAPI_PRIVATE_KEY=your_vapi_private_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
